<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Needed for CLRTestTargetUnsupported -->
    <RequiresProcessIsolation>true</RequiresProcessIsolation>
    <!-- Consider enable it for Mono whenever the implementation is ready -->
    <!-- https://github.com/dotnet/runtime/issues/73167 -->
    <CLRTestTargetUnsupported Condition="'$(RuntimeFlavor)' != 'coreclr'">true</CLRTestTargetUnsupported>
    <CLRTestPriority>0</CLRTestPriority>
  </PropertyGroup>
  <PropertyGroup>
    <DebugType>PdbOnly</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Collect_Aggressive.cs" />
    <!-- Reclamation must come from the explicit request, not the background trimmer or another GC's relocation. -->
    <CLRTestEnvironmentVariable Include="DOTNET_gcTrim" Value="0" />
    <CLRTestEnvironmentVariable Include="DOTNET_gcRelocatingGen1" Value="0" />
    <CLRTestEnvironmentVariable Include="DOTNET_gcRelocatingGen2" Value="0" />
  </ItemGroup>
</Project>
