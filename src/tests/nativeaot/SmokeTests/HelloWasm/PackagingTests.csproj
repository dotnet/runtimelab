<Project Sdk="Microsoft.Build.NoTargets">
  <PropertyGroup>
    <!-- This is the part of the package testing exposed to the runtime test infrastructure.
         The projects themselves are intentionally isolated from the rest of the tree. -->
    <CLRTestKind>BuildOnly</CLRTestKind>
  </PropertyGroup>

  <Target Name="PublishPackagingTestProject" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <Test_Configuration>$(Configuration)</Test_Configuration>
      <Test_TargetFramework>$(NetCoreAppCurrent)</Test_TargetFramework>
      <Test_RuntimeIdentifier>$(TargetOS)-$(TargetArchitecture)</Test_RuntimeIdentifier>
      <Test_RestoreSource>$(ArtifactsShippingPackagesDir)</Test_RestoreSource>
      <Test_RestorePackagesPath>$([MSBuild]::NormalizeDirectory('$(PackageOutputPath)', 'packages', '$(Configuration)'))</Test_RestorePackagesPath>
      <Test_HostPackageRuntimeIdentifier>$(NETCoreSdkPortableRuntimeIdentifier.Replace('-$(BuildArchitecture)', '-$(IlcHostArch)'))</Test_HostPackageRuntimeIdentifier>
    </PropertyGroup>

    <ItemGroup>
      <DotNetJsApiTestProject Include="PackagingTests/PackagingTestProject.DotNetJsApi.csproj"
                              Condition="'$(TargetsBrowser)' == 'true'"
                              ExpectedOutputFiles="dotnet.native.wasm;dotnet.native.js;dotnet.js;dotnet.runtime.js;dotnet.diagnostics.js;dotnet.js.map;dotnet.runtime.js.map;dotnet.diagnostics.js.map" />

      <PackagingTestProject Include="PackagingTests/PackagingTestProject.csproj;@(DotNetJsApiTestProject)">
        <BuildProperties>
          TreatWarningsAsErrors=true;
          Test_Configuration=$(Test_Configuration);
          Test_TargetFramework=$(Test_TargetFramework);
          Test_RuntimeIdentifier=$(Test_RuntimeIdentifier);
          Test_PackageVersion=$(NetCoreAppCurrentVersion).0-*;
          Test_RestoreSource=$(Test_RestoreSource);
          Test_RestorePackagesPath=$(Test_RestorePackagesPath);
          Test_HostPackageRuntimeIdentifier=$(Test_HostPackageRuntimeIdentifier);
          _hostArchitecture=$(IlcHostArch); <!-- Override host package resolution in ILC targets. -->
        </BuildProperties>
      </PackagingTestProject>
      <PackagingTestProject OutputPathRoot="$(OutputPath)%(FileName)/" />
      <PackagingTestProject BuildProperties="Test_TestOutputPath=%(OutputPathRoot);%(BuildProperties)" />

      <!-- TODO-LLVM: on ARM64 these fail. -->
      <SampleProject Include="$(RepoRoot)samples/HelloWorld/HelloWorld.csproj;
                              $(RepoRoot)samples/NativeLibrary/NativeLibrary.csproj">
        <BuildProperties>
          Configuration=$(Test_Configuration);
          RuntimeIdentifier=$(Test_RuntimeIdentifier);
        </BuildProperties>
      </SampleProject>
      <SampleProject OutputPathRoot="%(RootDir)%(Directory)" />

      <PackagingTestProject Include="@(SampleProject)"
                            Condition="'$(Test_HostPackageRuntimeIdentifier)' == '$(NETCoreSdkPortableRuntimeIdentifier)'" />

      <PackagingTestProject Condition="'%(PackagingTestProject.ExpectedOutputFiles)' == ''"
                            ExpectedOutputFiles="%(FileName).wasm" />
      <PackagingTestProject Condition="'$(TargetsBrowser)' == 'true' And '%(PackagingTestProject.FileName)' != 'PackagingTestProject.DotNetJsApi'"
                            ExpectedOutputFiles="%(ExpectedOutputFiles);%(FileName).js" />
      <PackagingTestProject Condition="'$(TargetsBrowser)' == 'true' And ('%(PackagingTestProject.FileName)' == 'PackagingTestProject' Or '%(PackagingTestProject.FileName)' == 'HelloWorld')"
                            ExpectedOutputFiles="%(ExpectedOutputFiles);%(FileName).html" />
      <!-- These test projects use the SDK publish pipeline, which also emits application metadata. -->
      <PackagingTestProject ExpectedOutputFiles="%(ExpectedOutputFiles);%(FileName).deps.json" />
      <PackagingTestProject Condition="'%(PackagingTestProject.FileName)' != 'NativeLibrary'"
                            ExpectedOutputFiles="%(ExpectedOutputFiles);%(FileName).runtimeconfig.json" />
      <PackagingTestProject PublishDirectory="%(OutputPathRoot)/bin/$(Test_Configuration)/$(Test_TargetFramework)/$(Test_RuntimeIdentifier)/publish/" />
    </ItemGroup>

    <Error Condition="!Exists($(Test_RestoreSource))"
           Text="The 'nativeaot.packages' subset must be built before building this project" />

    <Message Text="Packed packages: '$(Test_RestoreSource)'" Importance="High" />
    <Message Text="Unpacked packages: '$(Test_RestorePackagesPath)'" Importance="High" />

    <!-- Always start with a clean unpacked state so that there is no need to
         manually delete the old packages for the new ones to be picked up. 
         WARNING: one still needs to manually delete the **source** packages
         before "./build nativeaot.packages" because the pkgproj targets do
         not declare their inputs properly. -->
    <RemoveDir Directories="$(Test_RestorePackagesPath)" />
    <RemoveDir Directories="%(PackagingTestProject.OutputPathRoot)bin;
                            %(PackagingTestProject.OutputPathRoot)obj" />

    <MSBuild Projects="@(PackagingTestProject)"
             Targets="Restore"
             Properties="%(BuildProperties);
                         MSBuildRestoreSessionId=$([System.Guid]::NewGuid())" />

    <MSBuild Projects="@(PackagingTestProject)"
             Targets="Publish"
             Properties="%(BuildProperties)" />
  </Target>

  <!-- Batch by project so each publish directory is checked against its own expected files. -->
  <Target Name="VerifyPackagingTestPublishOutput"
          AfterTargets="PublishPackagingTestProject"
          Outputs="%(PackagingTestProject.Identity)">
    <PropertyGroup>
      <_PublishDirectory>%(PackagingTestProject.PublishDirectory)</_PublishDirectory>
    </PropertyGroup>
    <ItemGroup>
      <_ExpectedRelativeFile Include="%(PackagingTestProject.ExpectedOutputFiles)" />
      <_ExpectedFile Include="@(_ExpectedRelativeFile->'$(_PublishDirectory)%(Identity)')" />
      <_ActualFile Include="$(_PublishDirectory)**/*" />
      <_MissingFile Include="@(_ExpectedFile)" />
      <_MissingFile Remove="@(_ActualFile)" MatchOnMetadata="FullPath" MatchOnMetadataOptions="PathLike" />
      <_UnexpectedFile Include="@(_ActualFile)" />
      <_UnexpectedFile Remove="@(_ExpectedFile)" MatchOnMetadata="FullPath" MatchOnMetadataOptions="PathLike" />
    </ItemGroup>

    <Error Condition="'@(_MissingFile)' != '' Or '@(_UnexpectedFile)' != ''"
           ContinueOnError="ErrorAndContinue"
           Text="%(PackagingTestProject.Identity) produced an unexpected publish file set. Missing: [@(_MissingFile, ', ')]. Unexpected: [@(_UnexpectedFile, ', ')]." />
  </Target>
</Project>
