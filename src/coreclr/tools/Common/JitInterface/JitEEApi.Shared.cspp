public enum CorInfoLlvmEHModel
{
    CORINFO_LLVM_EH_CPP, // Landingpad-based LLVM IR; compatible with Itanium ABI.
    CORINFO_LLVM_EH_WASM, // WinEH-based LLVM IR; custom WASM EH-based ABI.
    CORINFO_LLVM_EH_EMULATED, // Invoke-free LLVM IR; "unwinding" performed via explicit checks and returns
};

enum CorInfoLlvmJitTestKind
{
    CORINFO_LLVM_JIT_TEST_LSSA = 1
};

enum CorInfoLlvmSingleThreadedCompilationContextFlags
{
    CORINFO_LLVM_STCC_ROOT_DEBUG_TYPES = 1 << 1
};

enum CorJitApiId
{
    CJAI_StartSingleThreadedCompilation,
    CJAI_FinishSingleThreadedCompilation,
    CJAI_EmitDebugTypeInfo,
    CJAI_EmitDebugMethodDecl,
    CJAI_Count
};

enum EEApiId
{
    EEAI_GetMangledMethodName,
    EEAI_GetMangledSymbolName,
    EEAI_GetMangledFilterFuncletName,
    EEAI_GetSignatureForMethodSymbol,
    EEAI_AddCodeReloc,
    EEAI_GetPrimitiveTypeForTrivialWasmStruct,
    EEAI_GetTypeDescriptor,
    EEAI_GetAlternativeFunctionName,
    EEAI_GetExternalMethodAddress,
    EEAI_GetDebugInfoForCurrentMethod,
    EEAI_GetSingleThreadedCompilationContext,
    EEAI_GetExceptionHandlingModel,
    EEAI_GetExceptionThrownVariable,
    EEAI_GetVirtualUnwindModel,
    EEAI_GetSparseVirtualUnwindInfo,
    EEAI_GetPreciseVirtualUnwindInfo,
    EEAI_IsVirtualUnwindFrameVisible,
    EEAI_GetJitTestInfo,
    EEAI_Count
};

enum CorInfoLlvmVirtualUnwindModel
{
    CILVUM_Sparse,
    CILVUM_Precise
};

enum CorInfoLlvmDebugTypeKind
{
    CORINFO_LLVM_DEBUG_TYPE_UNDEF,
    CORINFO_LLVM_DEBUG_TYPE_PRIMITIVE,
    CORINFO_LLVM_DEBUG_TYPE_COMPOSITE,
    CORINFO_LLVM_DEBUG_TYPE_ENUM,
    CORINFO_LLVM_DEBUG_TYPE_ARRAY,
    CORINFO_LLVM_DEBUG_TYPE_POINTER,
    CORINFO_LLVM_DEBUG_TYPE_FORWARD,
    CORINFO_LLVM_DEBUG_TYPE_FUNCTION,
    CORINFO_LLVM_DEBUG_TYPE_COUNT
};

enum CorInfoLlvmDebugTypeForwardKind
{
    CORINFO_LLVM_DEBUG_TYPE_FORWARD_STRUCT,
    CORINFO_LLVM_DEBUG_TYPE_FORWARD_ENUM
};

