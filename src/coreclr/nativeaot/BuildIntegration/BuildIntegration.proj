<Project Sdk="Microsoft.Build.NoTargets">
  <!-- TODO-LLVM-Upstream: https://github.com/dotnet/runtimelab/issues/2576 -->
  <PropertyGroup>
    <IsNativeAotProject>false</IsNativeAotProject>
  </PropertyGroup>

  <PropertyGroup>
    <OutputPath>$(RuntimeBinDir)/build/</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="*.*" Exclude="$(MSBuildProjectFile)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
