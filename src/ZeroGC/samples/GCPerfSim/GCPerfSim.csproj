<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Vendored, unmodified from https://github.com/dotnet/performance
    (src/benchmarks/gc/GCPerfSim), MIT licensed, used here as a more
    realistic GC allocation workload generator than the small hand-rolled
    ConsoleApp/WebApi samples. See README.md in this repo for the specific
    scenario presets (parameter sets) used to drive it.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <RootNamespace>gcperfsim_core</RootNamespace>
  </PropertyGroup>
  <PropertyGroup>
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
    <NullableReferenceTypes>true</NullableReferenceTypes>
  </PropertyGroup>
</Project>
