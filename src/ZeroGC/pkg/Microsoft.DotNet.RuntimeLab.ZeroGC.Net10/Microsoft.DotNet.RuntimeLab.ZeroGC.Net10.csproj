<Project Sdk="Microsoft.Build.NoTargets">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Microsoft.DotNet.RuntimeLab.ZeroGC.Net10</PackageId>
    <Description>
      ZeroGC - an experimental, allocate-only standalone CoreCLR GC that never
      reclaims memory - prebuilt for apps targeting .NET 10.0 (GA ABI). See
      https://github.com/dotnet/runtimelab/tree/feature/ZeroGC for details,
      caveats, and how to enable it via the DOTNET_GCName knob. NOT for
      production use.
    </Description>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <IncludeBuildOutput>true</IncludeBuildOutput>
    <IsPackable>true</IsPackable>
    <!-- Native-only package: no ref/lib managed assets. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <DisablePackageBaselineValidation>true</DisablePackageBaselineValidation>

    <!-- Reference dotnet/runtime checkout used ONLY as a read-only
         header/ABI dependency to compile ZeroGC against - never built or
         modified. Must point at a net10.0 GA-era checkout (ZeroGC's net10.0
         and net11.0 builds are ABI-incompatible - see
         src/ZeroGC/README.md, section "Supported runtime versions & versioning policy" -
         hence the separate Net10/Net11 packages). Override via the
         ZEROGC_NET10_RUNTIME_REPO environment variable in CI; defaults to
         the conventional local dev checkout path used throughout this
         repo's docs. -->
    <ZeroGCReferenceRuntimeRepo Condition="'$(ZeroGCReferenceRuntimeRepo)' == ''">$(ZEROGC_NET10_RUNTIME_REPO)</ZeroGCReferenceRuntimeRepo>
    <ZeroGCReferenceRuntimeRepo Condition="'$(ZeroGCReferenceRuntimeRepo)' == ''">C:\github\runtime-net10.0-ga</ZeroGCReferenceRuntimeRepo>
    <ZeroGCNativeDir>$(MSBuildThisFileDirectory)..\..\native</ZeroGCNativeDir>
  </PropertyGroup>

  <!--
    Each OS leg of the pipeline (Windows/Linux, see
    eng/pipelines/runtimelab-official.yml) runs this pack step and produces a
    PARTIAL package containing only that OS's native/{rid} asset - that's
    fine for those per-leg build/test jobs, since they aren't what gets
    signed/published. The official pipeline's actual signing job
    ("Prepare Signed Artifacts", eng/pipelines/common/jobs/prepare-signed-artifacts.yml)
    re-runs `build.cmd -pack` from source on a single Windows machine, after
    downloading every leg's uploaded IntermediateArtifacts. The
    IncludeLinuxNativeAssetFromIntermediateArtifacts target below runs only
    in that job (detected via the downloaded Linuxx64 artifact folder being
    present) and pulls the already-built libZeroGC.so back out of the Linux
    leg's partial .nupkg, so the single combined pack produced by that job -
    the one that actually gets signed and published - carries both RIDs.
  -->
  <Target Name="BuildZeroGCNativeWindows"
          Condition="'$(OS)' == 'Windows_NT'"
          BeforeTargets="Build">
    <Error Condition="!Exists('$(ZeroGCReferenceRuntimeRepo)\src\coreclr')"
           Text="ZeroGCReferenceRuntimeRepo ('$(ZeroGCReferenceRuntimeRepo)') does not look like a dotnet/runtime checkout (expected 'src\coreclr' under it). Set the ZEROGC_NET10_RUNTIME_REPO environment variable or pass /p:ZeroGCReferenceRuntimeRepo=&lt;path&gt;." />
    <!--
      IgnoreStandardErrorWarningFormat: MSBuild's Exec task scans tool
      output for lines matching its canonical error/warning regex and
      promotes matches to real MSBuild warnings/errors. Because the root
      Directory.Build.props (Arcade convention) sets
      TreatWarningsAsErrors=true, an ordinary compiler diagnostic emitted
      by build.ps1's underlying cl.exe/clang++ invocation (e.g. a
      dotnet/runtime header emitting an -W... note) would otherwise be
      silently escalated into a hard MSBuild build failure despite the
      native build having actually succeeded. Native build failures are
      already surfaced via this script's own exit code (Exec fails the
      target on nonzero exit regardless of this setting).
    -->
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(ZeroGCNativeDir)\build.ps1&quot; -RuntimeRepo &quot;$(ZeroGCReferenceRuntimeRepo)&quot; -Configuration Release"
          IgnoreStandardErrorWarningFormat="true" />
    <!--
      IMPORTANT: these Pack="true" items must be added HERE, inside this
      target's execution, rather than in a plain top-level <ItemGroup> -
      MSBuild evaluates top-level items (and their Condition="Exists(...)"
      checks) once at project-evaluation time, BEFORE any target (including
      this one) has run, so a top-level item would never see the freshly
      built binary from the Exec call above. Adding the item dynamically
      inside the target (which runs BeforeTargets="Build", and Pack depends
      on Build) ensures NuGet's pack step sees it.
    -->
    <ItemGroup>
      <None Include="$(ZeroGCNativeDir)\obj\Release\ZeroGC.dll"
            PackagePath="runtimes/win-x64/native"
            Pack="true"
            Condition="Exists('$(ZeroGCNativeDir)\obj\Release\ZeroGC.dll')" />
    </ItemGroup>
  </Target>

  <!--
    ZeroGC only ships win-x64/linux-x64 native assets - there is no macOS
    support (ZeroGCPal.h uses Linux/glibc-specific APIs like
    sys/sysinfo.h that don't exist on Darwin). The repo's generic CI
    matrix (eng/pipelines/runtimelab.yml) also runs an "OSX x64" leg that
    isn't RID-specific to ZeroGC's packaging, so this target must key off
    the actual OS, not merely "not Windows" - otherwise it would
    incorrectly attempt (and fail) a Linux-flavored native build on
    macOS agents.
  -->
  <Target Name="BuildZeroGCNativeLinux"
          Condition="$([MSBuild]::IsOSPlatform('Linux'))"
          BeforeTargets="Build">
    <Error Condition="!Exists('$(ZeroGCReferenceRuntimeRepo)/src/coreclr')"
           Text="ZeroGCReferenceRuntimeRepo ('$(ZeroGCReferenceRuntimeRepo)') does not look like a dotnet/runtime checkout (expected 'src/coreclr' under it). Set the ZEROGC_NET10_RUNTIME_REPO environment variable or pass /p:ZeroGCReferenceRuntimeRepo=&lt;path&gt;." />
    <Exec Command="&quot;$(ZeroGCNativeDir)/build-linux.sh&quot; --runtime-repo &quot;$(ZeroGCReferenceRuntimeRepo)&quot; --configuration Release"
          IgnoreStandardErrorWarningFormat="true" />
    <!-- Same dynamic-item timing note as the Windows target above applies here. -->
    <ItemGroup>
      <None Include="$(ZeroGCNativeDir)/obj-linux/Release/libZeroGC.so"
            PackagePath="runtimes/linux-x64/native"
            Pack="true"
            Condition="Exists('$(ZeroGCNativeDir)/obj-linux/Release/libZeroGC.so')" />
    </ItemGroup>
  </Target>

  <Target Name="IncludeLinuxNativeAssetFromIntermediateArtifacts"
          Condition="'$(OS)' == 'Windows_NT' and Exists('$(BUILD_SOURCESDIRECTORY)\artifacts\PackageDownload\IntermediateArtifacts\Linuxx64\Shipping')"
          BeforeTargets="Build">
    <ItemGroup>
      <_ZeroGCLinuxPartialNupkg Include="$(BUILD_SOURCESDIRECTORY)\artifacts\PackageDownload\IntermediateArtifacts\Linuxx64\Shipping\$(PackageId).*.nupkg" />
    </ItemGroup>
    <PropertyGroup>
      <_ZeroGCLinuxExtractDir>$(IntermediateOutputPath)linux-native-extract\</_ZeroGCLinuxExtractDir>
    </PropertyGroup>
    <Error Condition="'@(_ZeroGCLinuxPartialNupkg)' == ''"
           Text="Expected a Linux partial package matching '$(PackageId).*.nupkg' under artifacts\PackageDownload\IntermediateArtifacts\Linuxx64\Shipping, but none was found - did the official build's Linux leg fail to produce/upload its intermediate artifact?" />
    <RemoveDir Directories="$(_ZeroGCLinuxExtractDir)" Condition="Exists('$(_ZeroGCLinuxExtractDir)')" />
    <!-- Expand-Archive refuses to extract .nupkg (it only recognizes the
         .zip extension, even though a nupkg is a zip file), so extract via
         System.IO.Compression.ZipFile directly instead. -->
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;Add-Type -AssemblyName System.IO.Compression.FileSystem; [System.IO.Compression.ZipFile]::ExtractToDirectory('%(_ZeroGCLinuxPartialNupkg.FullPath)', '$(_ZeroGCLinuxExtractDir)')&quot;" />
    <ItemGroup>
      <None Include="$(_ZeroGCLinuxExtractDir)runtimes\linux-x64\native\libZeroGC.so"
            PackagePath="runtimes/linux-x64/native"
            Pack="true"
            Condition="Exists('$(_ZeroGCLinuxExtractDir)runtimes\linux-x64\native\libZeroGC.so')" />
    </ItemGroup>
    <Error Condition="!Exists('$(_ZeroGCLinuxExtractDir)runtimes\linux-x64\native\libZeroGC.so')"
           Text="Extracted the Linux partial package but did not find runtimes/linux-x64/native/libZeroGC.so inside it - check the Linux leg's pack output." />
  </Target>

</Project>
