<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <!-- Experiment package versions properties -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <!-- File version numbers -->
    <MajorVersion>0</MajorVersion>
    <MinorVersion>1</MinorVersion>
    <PatchVersion>0</PatchVersion>
    <!-- Keep this short (max 7 chars, NuGet version-length limit) and unique
         across dotnet-experimental feed packages, per CreateAnExperiment.md. -->
    <PreReleaseVersionLabel>zgcrs</PreReleaseVersionLabel>
    <!-- Opt-out repo features -->
    <UsingToolXliff>false</UsingToolXliff>
  </PropertyGroup>
</Project>
