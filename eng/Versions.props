<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <!-- ZeroGC package versions properties -->
    <VersionPrefix>1.0.0</VersionPrefix>
    <!-- File version numbers -->
    <MajorVersion>1</MajorVersion>
    <MinorVersion>0</MinorVersion>
    <PatchVersion>0</PatchVersion>
    <!-- Short, unique prerelease label so ZeroGC packages don't clash with
         other dotnet/runtimelab experiments sharing the dotnet-experimental
         feed. -->
    <PreReleaseVersionLabel>zerogc</PreReleaseVersionLabel>
    <!-- Opt-out repo features -->
    <UseVSTestRunner>true</UseVSTestRunner>
    <UsingToolXliff>false</UsingToolXliff>
    <!-- Libs -->
    <MicrosoftNETTestSdkVersion>18.0.1</MicrosoftNETTestSdkVersion>
    <XUnitVersion>2.9.3</XUnitVersion>
    <XUnitRunnerVisualStudioVersion>4.0.0-pre.4</XUnitRunnerVisualStudioVersion>
    <UseDotNetXUnitAssert>true</UseDotNetXUnitAssert>
    <!-- ZeroGC ships two ABI-incompatible packages (Net10 / Net11) rather
         than pinning one global custom runtime version - see
         Directory.Build.props: UseCustomRuntimeVersion is disabled for
         this repo, and each packaging project pins its own target
         net10.0/net11.0 GA/preview reference explicitly. -->
  </PropertyGroup>
</Project>
